load("@rules_qt//:qt.bzl", "qt_cc_binary", "qt_cc_library")

qt_cc_library(
    name = "duolingo_lib",
    srcs = [
        "answerchecker.cpp",
        "appstyle.cpp",
        "audiohelper.cpp",
        "difficultydialog.cpp",
        "mainwindow.cpp",
        "questionrepository.cpp",
    ],
    hdrs = [
        "answerchecker.h",
        "appstyle.h",
        "audiohelper.h",
        "difficultydialog.h",
        "mainwindow.h",
        "question.h",
        "questionrepository.h",
    ],
    deps = [
        "@rules_qt//:qt_core",
        "@rules_qt//:qt_gui",
        "@rules_qt//:qt_multimedia",
        "@rules_qt//:qt_widgets",
    ],
)

qt_cc_binary(
    name = "duolingo",
    srcs = ["main.cpp"],
    data = [
        "correct.wav",
        "wrong.wav",
    ],
    deps = [
        ":duolingo_lib",
        "@rules_qt//:qt_widgets",
    ],
