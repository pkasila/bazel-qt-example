load("@rules_cc//cc:defs.bzl", "cc_library", "cc_binary")

cc_library(
    name = "raycaster_lib",
    srcs = [
        "controller.cpp",
        "polygon.cpp",
        "ray.cpp",
        "widget.cpp",
    ],
    hdrs = [
        "controller.h",
        "polygon.h",
        "ray.h",
        "widget.h",
        "mode.h",
    ],
    deps = [
        "@rules_qt//:qt_core",
        "@rules_qt//:qt_gui",
        "@rules_qt//:qt_widgets",
    ],
    defines = [
        "QT_CORE_LIB",
        "QT_GUI_LIB",
        "QT_WIDGETS_LIB",
    ],
    visibility = [":__subpackages__"],
)

cc_binary(
    name = "basics",
    srcs = ["main.cpp"],
    deps = [":raycaster_lib"],
    visibility = ["//visibility:public"],
)