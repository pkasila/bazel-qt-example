# task1/BUILD.bazel
package(default_visibility = ["//visibility:public"])

genrule(
    name = "mainwindow_moc",
    srcs = ["mainwindow.h"],
    outs = ["mainwindow.moc.cpp"],
    # Правильный путь к moc для Qt6
    cmd = "/usr/lib/qt6/libexec/moc $(SRCS) -o $@",
)

cc_binary(
    name = "ticket_reviewer",
    srcs = [
        "main.cpp",
        "mainwindow.cpp",
        "mainwindow.h",
        ":mainwindow_moc",  # Ссылка на target genrule
    ],
    copts = [
        "-std=c++17",
        "-fPIC",
        "-DQT_WIDGETS_LIB",
        "-DQT_GUI_LIB",
        "-DQT_CORE_LIB",
        "-I/usr/include/x86_64-linux-gnu/qt6",
        "-I/usr/include/x86_64-linux-gnu/qt6/QtCore",
        "-I/usr/include/x86_64-linux-gnu/qt6/QtGui",
        "-I/usr/include/x86_64-linux-gnu/qt6/QtWidgets",
    ],
    linkopts = [
        "-L/usr/lib/x86_64-linux-gnu",
        "-lQt6Widgets",
        "-lQt6Gui",
        "-lQt6Core",
        "-lpthread",
    ],
)